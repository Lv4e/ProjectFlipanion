{
  "nodeModulesDir": "auto",
  "tasks": {
    "dev": "deno run --watch  main.ts",
    "prisma:studio": "deno run -A prisma studio --hostname 0.0.0.0",
    "prisma:seed": "deno run -A --env-file seed.ts",
    "prisma:debug_seed": "deno run -A --env-file --inspect-wait seed.ts",
    "prisma:migrate_dev": "deno run -A prisma migrate dev",
    "prisma:db_push": "deno run -A prisma db push",
    "prisma:generate": "deno run -A prisma generate",
    "prisma:validate": "deno run -A prisma validate",
    "prisma:migrate_status": "deno run -A prisma migrate status"
  },
  "imports": {
    "prisma": "npm:prisma@^6.19.2",
    "@prisma/client": "npm:@prisma/client@^6.19.2",
    "@std/assert": "jsr:@std/assert@1",
    "he": "npm:he@^1.2.0"
  },
  "fmt": {
    "indentWidth": 4,
    "lineWidth": 130,
    "singleQuote": false,
    "proseWrap": "never"
  }
}
