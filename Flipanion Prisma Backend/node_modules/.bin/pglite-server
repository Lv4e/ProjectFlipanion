#!/bin/sh
basedir=$(dirname "$(echo "$0" | sed -e 's,\\,/,g')")

case `uname` in
    *CYGWIN*|*MINGW*|*MSYS*)
        if command -v cygpath > /dev/null 2>&1; then
            basedir=`cygpath -w "$basedir"`
        fi
    ;;
esac

if [ -x "$basedir/node" ]; then
  exec "$basedir/node"  "$basedir/../.deno/@electric-sql+pglite-socket@0.0.6/node_modules/@electric-sql/pglite-socket/dist/scripts/server.js" "$@"
else
  exec node  "$basedir/../.deno/@electric-sql+pglite-socket@0.0.6/node_modules/@electric-sql/pglite-socket/dist/scripts/server.js" "$@"
fi
