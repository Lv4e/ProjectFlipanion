generator client {
  provider = "prisma-client"
  output   = "./client"
  runtime  = "deno"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id             Int             @id @default(autoincrement())
  email          String          @unique
  passwordHash   String
  name           String          @unique 
  createdAt      DateTime        @default(now())
  supabaseId     String?         @unique
  avatarUrl      String?
  points         Points[]
  userAnswers    UserAnswer[]
  userStatistics UserStatistics?
}

model Subject {
  id          Int      @id @default(autoincrement())
  name        String   @unique      
  description String?
  points      Points[]
  quizzes     Quiz[]
}

model Points {
  id        Int     @id @default(autoincrement())
  userId    Int
  subjectId Int
  points    Int
  subject   Subject @relation(fields: [subjectId], references: [id])
  user      User    @relation(fields: [userId], references: [id])

  @@unique([userId, subjectId])
}

model Question {
  id            Int          @id @default(autoincrement())
  questionText  String
  answerText1   String
  answerText2   String
  answerText3   String
  answerText4   String
  correctAnswer String
  quizId        Int
  quiz          Quiz         @relation(fields: [quizId], references: [id])
  userAnswers   UserAnswer[]
}

model UserAnswer {
  id             Int      @id @default(autoincrement())
  userId         Int
  questionId     Int
  isCorrect      Boolean
  selectedAnswer String
  question       Question @relation(fields: [questionId], references: [id])
  user           User     @relation(fields: [userId], references: [id])
}

model UserStatistics {
  id                Int  @id @default(autoincrement())
  userId            Int  @unique
  answeredQuestions Int
  correctAnswers    Int
  user              User @relation(fields: [userId], references: [id])
}

model Quiz {
  id          Int        @id @default(autoincrement())
  title       String
  description String?
  createdAt   DateTime   @default(now())
  subjectId   Int
  questions   Question[]
  subject     Subject    @relation(fields: [subjectId], references: [id])

  @@unique([title, subjectId])      
}
